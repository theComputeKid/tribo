ninja_required_version = 1.3
builddir = tmp/$toolkit/$build_config

tmp_dir = $builddir
bin_dir = bin/$toolkit/$build_config

# Include directories
inc_dir = -Iinclude -Ivendor

include ninja/compiler_flags/$build_config/$toolkit.ninja
include ninja/rules/$toolkit.ninja
include ninja/rules/run.ninja

# projects
include ninja/targets/cli.ninja

build run: run $bin_dir/tribo-cli.exe
  cmd = $bin_dir/tribo-cli.exe

default cli
