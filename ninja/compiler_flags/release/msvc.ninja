ccxx_flags = $
  /diagnostics:caret $
  /external:anglebrackets $
  /external:W0 $
  /W4 $
  /WX $
  /nologo $
  /showIncludes $
  /options:strict $
  /permissive- $
  /FC $
  /Zc:preprocessor $
  /openmp $
  /O2 $
  /MD

c_flags = /std:c11 /TC /Zc:__STDC__ $ccxx_flags
cxx_flags = /std:c++latest /TP /Zc:__cplusplus /EHsc $ccxx_flags

ccxx_flags_avx2 = /arch:AVX2 /FAs /Qvec-report:1

ld_flags = /NOLOGO /WX /INCREMENTAL:NO

ar_flags = /NOLOGO /WX
